# ==============================================================================
# PRIVATE MESSENGER BACKEND CONFIGURATION
# ==============================================================================
# Copy this file to .env and customize values for your environment.
#
# MARKINGS:
# [SECRET/BACKEND ONLY] : Never share with clients or put into mobile app code.
# [PUBLIC/APP CONFIG]  : Safe to share with mobile app developer and client config.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION [SECRET/BACKEND ONLY]
# ------------------------------------------------------------------------------
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
# Base public URL where this backend is reached (e.g., https://my-messenger.onrender.com)
SERVER_PUBLIC_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION [SECRET/BACKEND ONLY]
# ------------------------------------------------------------------------------
# PostgreSQL connection string.
# In Render: Automatically provided by your Render PostgreSQL service (Internal Database URL).
# Local: postgresql+asyncpg://postgres:postgres@localhost:5432/messenger
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/messenger

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY [SECRET/BACKEND ONLY]
# ------------------------------------------------------------------------------
# Generate a strong 64-char key using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_very_secure_random_secret_key_minimum_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# ------------------------------------------------------------------------------
# 3b. OWNER SERVER-STATUS NOTIFICATION [BACKEND CONFIG]
# ------------------------------------------------------------------------------
# Configures the username of the account owner.
# When the server wakes up from Render sleep and becomes online, only this owner
# account receives the "server:online" event to display "🟢 Server is online".
# Never hardcode passwords or secrets for the owner.
OWNER_USERNAME=

# ------------------------------------------------------------------------------
# 4. CORS ORIGINS [SECRET/BACKEND ONLY - Server config]
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins (e.g. http://localhost:3000,https://myfrontend.com)
CORS_ORIGINS=*

# ------------------------------------------------------------------------------
# 5. WEBRTC STUN / TURN CONFIGURATION
# ------------------------------------------------------------------------------
# [PUBLIC/APP CONFIG] Primary Google public STUN server (safe for mobile apps)
STUN_SERVER=stun:stun.l.google.com:19302

# [PUBLIC/APP CONFIG] Optional fallback STUN server
STUN_SERVER_SECONDARY=stun:stun1.l.google.com:19302

# [PUBLIC/APP CONFIG] Optional TURN server URL (e.g., turn:turn.example.com:3478)
TURN_SERVER=

# [PUBLIC/APP CONFIG] Optional TURN username
TURN_USERNAME=

# [SECRET/BACKEND ONLY / SENSITIVE] Optional TURN password or credential
# Note: In production, backend issues temporary TURN credentials through GET /api/calls/config
TURN_PASSWORD=

# ------------------------------------------------------------------------------
# 6. STORAGE PROVIDER CONFIGURATION [SECRET/BACKEND ONLY]
# ------------------------------------------------------------------------------
# Options: 'local' (development only) or 's3' (AWS S3, Cloudflare R2, MinIO, etc.)
STORAGE_PROVIDER=local

# Local storage directory path (used when STORAGE_PROVIDER=local)
LOCAL_UPLOAD_DIR=uploads

# S3 / Cloudflare R2 settings (used when STORAGE_PROVIDER=s3)
STORAGE_BUCKET=my-messenger-files
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# S3 Endpoint URL (e.g., https://<accountid>.r2.cloudflarestorage.com or empty for AWS)
STORAGE_ENDPOINT_URL=
# Public CDN/Custom domain URL prefix for uploaded media (e.g., https://media.example.com)
STORAGE_PUBLIC_URL_PREFIX=

# Maximum upload limits in bytes (Default: 50MB)
MAX_FILE_SIZE_BYTES=52428800

# ------------------------------------------------------------------------------
# 7. FIREBASE CLOUD MESSAGING (PUSH NOTIFICATIONS) [SECRET/BACKEND ONLY]
# ------------------------------------------------------------------------------
# For Android/iOS push notifications when app is closed.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
